APP_NAME="Starter Kit"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Europe/Istanbul
APP_URL=http://localhost
APP_LOCALE=tr
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=tr_TR

APP_MAINTENANCE_DRIVER=file
APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Database -----------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=starter_kit
DB_USERNAME=root
DB_PASSWORD=

# Cache / Session / Queue (shared cPanel: no Redis; database or file) -
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database
CACHE_PREFIX=starter_kit_

# Redis --------------------------------------------------------------
REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1

# Mail ---------------------------------------------------------------
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Storage / S3 (optional) --------------------------------------------
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=eu-central-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Vite ---------------------------------------------------------------
VITE_APP_NAME="${APP_NAME}"

# Sanctum / Inertia --------------------------------------------------
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:5173,127.0.0.1,127.0.0.1:8000

# Module toggles -----------------------------------------------------
MODULE_CORPORATE_ENABLED=true
MODULE_ECOMMERCE_ENABLED=true
MODULE_REALESTATE_ENABLED=true
MODULE_MEDIA_ENABLED=true

# Response cache -----------------------------------------------------
RESPONSE_CACHE_ENABLED=true
RESPONSE_CACHE_LIFETIME=3600

# Payment: Stripe ----------------------------------------------------
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=

# Payment: iyzico ----------------------------------------------------
IYZICO_API_KEY=
IYZICO_SECRET_KEY=
IYZICO_BASE_URL=https://sandbox-api.iyzipay.com

# SEO ----------------------------------------------------------------
# Test/staging hostlarında (APP_ENV=production olsa da) false: noindex + robots.txt Disallow: /
SEO_INDEXABLE=false
SEO_TRAILING_SLASH=false
SEO_TITLE_SEPARATOR=" · "
SEO_DESCRIPTION=
SEO_IMAGE=

# Kurulum (/kurulum/{token}, bkz. CPANEL_DEPLOY.md) -----------------------
# Uzun rastgele değer; işiniz bitince boşaltın (route 404 döner).
SETUP_TOKEN=
# Production'da ilk seed'in açacağı admin; boşsa admin oluşturulmaz.
SETUP_ADMIN_EMAIL=
SETUP_ADMIN_PASSWORD=

# Filament -----------------------------------------------------------
FILAMENT_PATH=admin
FILAMENT_DOMAIN=
